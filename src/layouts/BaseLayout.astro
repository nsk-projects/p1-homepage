---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  /** 글 상세는 "article", 나머지는 "website" */
  ogType?: "website" | "article";
}

const SITE_NAME = "NSK";
const SITE_DESCRIPTION = "개발 기록과 실험을 남기는 공간";

const {
    title = SITE_NAME,
    description = SITE_DESCRIPTION,
    ogType = "website",
} = Astro.props as Props;

// 브라우저 탭·검색 결과 제목: "페이지 | NSK" (홈은 "NSK")
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Dev Log`} href="/rss.xml" />

    <!-- 링크 공유 미리보기 (카톡·슬랙·페이스북 등) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <header class="site-header">
        <nav class="nav">
            <a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
            <a href="/devlog" class={currentPath.startsWith("/devlog") ? "active" : ""}>Dev Log</a>
            <a href="/lab" class={currentPath.startsWith("/lab") ? "active" : ""}>Lab</a>
            <a href="/about" class={currentPath === "/about" ? "active" : ""}>About</a>
        </nav>
    </header>

    <main class="content">
        <slot />
    </main>

    <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} NSK. All rights reserved.</p>
    </footer>
  </body>
</html>