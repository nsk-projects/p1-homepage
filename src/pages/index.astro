---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedPosts, formatDate, excerpt, postUrl } from "../lib/devlog";

// 최신 글 3편. 새 글을 올리면 자동으로 바뀐다.
const latestPosts = (await getSortedPosts()).slice(0, 3);
---

<BaseLayout title="NSK">
	<section>
		<h1>NSK</h1>
		<p>개발 기록과 실험을 남기는 공간</p>
	</section>

	<section>
		<h2>Latest Dev Log</h2>
		<div class="card-list">
			{latestPosts.map((post) => (
				<article class="card">
					<h3><a href={postUrl(post)}>{post.data.title}</a></h3>
					<p>{excerpt(post, 80)}</p>
					{post.data.date && (
						<div class="post-meta">
							<span class="post-date">{formatDate(post.data.date)}</span>
						</div>
					)}
				</article>
			))}
		</div>
		<p><a href="/devlog/">전체 글 보기 →</a></p>
	</section>

	<section>
		<h2>Recent Experiments</h2>
		<div class="card-list">
			<div class="card">
				<h3>Project: NSK Homepage</h3>
				<p>최소한의 디자인, 최대한의 가독성을 목표로 하는 프로젝트</p>
			</div>
		</div>
	</section>
</BaseLayout>
